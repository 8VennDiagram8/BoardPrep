# Copy to .env.local and fill in your Supabase project details.
# If these are omitted, BoardPrep runs in demo mode with local browser storage.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (used by /api/generate-questions; never exposed to the browser).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
